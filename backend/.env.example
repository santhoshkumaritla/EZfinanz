PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ezfinanz
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=EZfinanz <your-email@gmail.com>
AUTO_SEED_ADMIN=false
ADMIN_NAME=Admin User
# Optional override (defaults are admin@ezfinanz.com / admin123 if unset)
ADMIN_EMAIL=admin@ezfinanz.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=change_me
FORCE_ADMIN_PASSWORD_RESET=false
